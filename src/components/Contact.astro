---
import { CONTACT } from '../config/site';

const purposes = [
  'Business partnerships',
  'Research collaborations',
  'Technology partnerships',
  'General enquiries',
];
---

<section id="contact" class="section-alt">
  <div class="container">
    <div class="section-head centered">
      <p class="eyebrow">Contact</p>
      <h2>Work with RupamLab</h2>
      <p>
        We welcome conversations with technology partners, beauty and skincare companies,
        researchers, universities, data partners and organisations interested in applying
        computer vision and AI.
      </p>
    </div>

    <div class="contact-email">
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </div>

    <div class="purpose-grid">
      {purposes.map((purpose) => (
        <a class="card purpose-card" href={`mailto:${CONTACT.email}?subject=${encodeURIComponent(purpose)}`}>
          {purpose}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-email {
    text-align: center;
    margin-bottom: 40px;
  }

  .contact-email a {
    font-size: 22px;
    font-weight: 600;
    color: var(--teal-600);
    text-decoration: none;
  }

  .contact-email a:hover {
    text-decoration: underline;
  }

  .purpose-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .purpose-card {
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .purpose-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .purpose-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
