---
const cards = [
  {
    title: 'Computer Vision',
    body: 'Visual AI systems designed to extract structured information from real-world images.',
    icon: 'M1.5 12s3.75-6.75 10.5-6.75S22.5 12 22.5 12s-3.75 6.75-10.5 6.75S1.5 12 1.5 12Z M12 14.75a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5Z',
  },
  {
    title: 'Machine Learning',
    body: 'Models and evaluation pipelines designed around measurable performance and continuous improvement.',
    icon: 'M12 2.5 3 7v10l9 4.5 9-4.5V7l-9-4.5Z M3 7l9 4.5 9-4.5 M12 11.5V21',
  },
  {
    title: 'Data Intelligence',
    body: 'Structured datasets, annotation workflows, provenance and quality systems supporting reliable AI development.',
    icon: 'M4 6c0-1.66 3.58-3 8-3s8 1.34 8 3-3.58 3-8 3-8-1.34-8-3Z M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6 M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3',
  },
  {
    title: 'AI Infrastructure',
    body: 'APIs and scalable software infrastructure for integrating AI capabilities into commercial applications.',
    icon: 'M3 4.5h18v6H3v-6Z M3 13.5h18v6H3v-6Z M7 7.5h.01 M7 16.5h.01',
  },
];
---

<section id="technology">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Technology</p>
      <h2>Our technology focus</h2>
    </div>

    <div class="tech-grid">
      {cards.map((card) => (
        <div class="card">
          <div class="icon-tile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={card.icon} />
            </svg>
          </div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .tech-grid h3 {
    font-size: 18px;
    margin-bottom: 12px;
  }

  @media (max-width: 960px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
