---
import { PRODUCT } from '../config/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="RupamLab Private Limited — home">
      <img src="/brand/rupam-logo.png" alt="" width="116" height="42" />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <a href="/#company">Company</a>
      <a href="/#technology">Technology</a>
      <a href="/#rupam-ai">Rupam AI</a>
      <a href="/#research">Research</a>
      <a href="/#contact">Contact</a>
    </nav>

    <div class="header-right">
      <a class="btn btn-primary cta" href={PRODUCT.url} target="_blank" rel="noopener">
        <span>Visit Rupam AI →</span>
      </a>

      <details class="nav-mobile">
        <summary aria-label="Open menu">
          <span></span><span></span><span></span>
        </summary>
        <nav aria-label="Primary mobile">
          <a href="/#company">Company</a>
          <a href="/#technology">Technology</a>
          <a href="/#rupam-ai">Rupam AI</a>
          <a href="/#research">Research</a>
          <a href="/#contact">Contact</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 36px;
    width: auto;
  }

  .nav-desktop {
    display: flex;
    gap: 32px;
  }

  .nav-desktop a {
    text-decoration: none;
    color: var(--text);
    font-size: 16px;
    font-weight: 400;
    transition: color 0.15s ease;
  }

  .nav-desktop a:hover {
    color: var(--ink);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta {
    font-size: 14px;
    padding: 10px 18px;
    white-space: nowrap;
  }

  .nav-mobile {
    display: none;
    position: relative;
  }

  .nav-mobile summary {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile summary span {
    width: 16px;
    height: 2px;
    background: var(--ink);
    display: block;
  }

  .nav-mobile nav {
    position: absolute;
    top: 46px;
    right: 0;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    min-width: 200px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .nav-mobile nav a {
    padding: 10px 12px;
    text-decoration: none;
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    border-radius: 8px;
  }

  .nav-mobile nav a:hover {
    background: var(--bg-alt);
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .cta {
      padding: 10px 12px;
      font-size: 13px;
    }
  }
</style>
