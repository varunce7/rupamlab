---
import { PRODUCT, COMPANY_INFO, CONTACT } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/brand/rupam-logo-white.png" alt="" width="104" height="37" class="brand-logo" />
        <p class="brand-tagline">AI • Machine Learning • Computer Vision</p>
        <p class="brand-location">Ahmedabad, Gujarat, India</p>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <a href="/#company">Company</a>
        <a href="/#technology">Technology</a>
        <a href="/#research">Research</a>
      </div>

      <div class="footer-col">
        <h4>Product</h4>
        <a href={PRODUCT.url} target="_blank" rel="noopener">Rupam AI</a>
        <a href="/privacy">Privacy</a>
      </div>

      <div class="footer-col">
        <h4>Connect</h4>
        <a href="/#contact">Contact</a>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} RupamLab Private Limited. All rights reserved.</p>
      <p>CIN: {COMPANY_INFO.cin}</p>
      <p>Rupam AI is a product of RupamLab Private Limited.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-base);
    padding: 64px 0 32px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--navy-border);
  }

  .brand-logo {
    height: 30px;
    width: auto;
    margin-bottom: 16px;
  }

  .brand-tagline,
  .brand-location {
    font-size: 14px;
    color: var(--navy-text);
    margin-top: 6px;
  }

  .footer-col h4 {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal-400);
    margin-bottom: 16px;
  }

  .footer-col a {
    display: block;
    text-decoration: none;
    color: #ffffff;
    font-size: 14px;
    margin-bottom: 12px;
    opacity: 0.85;
  }

  .footer-col a:hover {
    opacity: 1;
    color: var(--teal-400);
  }

  .footer-bottom {
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer-bottom p {
    font-size: 13px;
    color: var(--navy-text);
    margin: 0;
  }

  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
